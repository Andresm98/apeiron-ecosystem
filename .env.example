# Entorno y Registro
APEIRON_ENV=dev
APEIRON_LOG_LEVEL=INFO
APEIRON_CORS_ORIGINS=["http://localhost:4200"]

# Identidad, sesiones e historial: Supabase (ADR-010)
# Datos en Supabase Dashboard -> Project Settings -> API Keys / Data API.
APEIRON_AUTH_PROVIDER=supabase                 # supabase | local (SQLite + JWT propio, sin persistencia de sesión)
# URL del proyecto: https://<project-ref>.supabase.co
APEIRON_SUPABASE_URL=https://gclucrupgdxtgfqifshp.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy. Es pública: no uses la secret/service_role.
APEIRON_SUPABASE_PUBLISHABLE_KEY=example
# Solo si el proyecto aún firma JWT con HS256 (legacy); con claves asimétricas se usa JWKS.
# APEIRON_SUPABASE_JWT_SECRET=
APEIRON_PERSIST_RUNS=true                      # guarda cada ejecución en public.agent_runs

# Seguridad y Autenticación JWT (modo local)
APEIRON_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# APEIRON_JWT_SECRET_PREVIOUS=secreto-anterior-para-rotacion
APEIRON_JWT_TTL_MINUTES=60
APEIRON_PUBLIC_REGISTER=true
APEIRON_USERS_DB_PATH=data/users.db
APEIRON_AUTH_RATE_LIMIT_PER_MIN=20
APEIRON_CHAT_RATE_LIMIT_PER_MIN=30

# Proveedor de Modelo de Lenguaje (LLM)
APEIRON_LLM_PROVIDER=openai                  # fake | anthropic | openai
APEIRON_LLM_MODEL=gpt-5.6-luna
APEIRON_LLM_MAX_TOKENS=1500
APEIRON_LLM_REASONING_EFFORT=low     # none | minimal | low | medium | high
# APEIRON_LLM_FALLBACK_MODEL=claude-3-5-haiku
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Resiliencia y Tiempos Límite (Timeouts / Circuit Breaker)
APEIRON_LLM_TIMEOUT_S=60.0
APEIRON_LLM_RETRIES=3
APEIRON_BREAKER_FAILURES=5
APEIRON_BREAKER_RECOVERY_S=30.0
APEIRON_NODE_TIMEOUT_S=90.0
APEIRON_DEFAULT_ROUNDS=1
APEIRON_MAX_REACT_STEPS=2
# Cada worker debe consultar al menos una herramienta antes de responder (+1 llamada LLM aprox. por worker).
APEIRON_REQUIRE_EVIDENCE=false
# Guardrails deterministas: inyección de prompts, secretos/PII y citas no verificadas. 0 tokens.
APEIRON_GUARDRAILS_ENABLED=true
APEIRON_SIMULATION_PACE_S=0.6           # pausa por paso del modo simulación (UI)
# APEIRON_DEBATE_PARTICIPANTS=["anaximandro","heraclito"]   # 1 a 4 workers registrados
APEIRON_TOOL_TIMEOUT_S=20.0

# Memoria Vectorial y ChromaDB
APEIRON_VECTOR_BACKEND=chroma           # chroma | memory
APEIRON_CHROMA_HOST=chroma
APEIRON_CHROMA_PORT=8000
APEIRON_MEMORY_MAX_DOCS_PER_USER=200
APEIRON_MEMORY_SEMANTIC_WEIGHT=0.6
APEIRON_MEMORY_LEXICAL_WEIGHT=0.4

# Integraciones de Herramientas y MCP
# Literatura académica con DOI: servidor MCP apeiron-scholar (OpenAlex). En Compose ya está cableada
# a http://mcp-scholar:8080/mcp; defínela solo fuera de Compose. Vacía = sin la herramienta.
# APEIRON_SCHOLAR_MCP_URL=http://localhost:8080/mcp
# Correo de contacto para el polite pool de OpenAlex (opcional; lo lee el servicio mcp-scholar).
# APEIRON_OPENALEX_MAILTO=
# Legado: un servidor MCP que SUSTITUYE a arXiv en mcp_public_api_tool.
# APEIRON_MCP_SERVER_URL=http://mcp-science:8080/mcp

# Protocolo A2A 1.0
# Servidor: publica /.well-known/agent-card.json y /a2a (JSON-RPC con el mismo Bearer que la API).
APEIRON_A2A_SERVER_ENABLED=true
# URL pública del origen (https://<dominio>); vacía = la de cada petición.
APEIRON_A2A_PUBLIC_URL=
# Cliente: workers remotos (máx. 4) y allowlist de hosts. La credencial de cada agente va en
# su propia variable APEIRON_A2A_TOKEN_<NOMBRE>; el JWT del usuario nunca se reenvía.
# APEIRON_A2A_REMOTE_AGENTS=[{"name":"sophos","url":"https://sophos.example.org","role":"Mayéutica socrática","token_env":"APEIRON_A2A_TOKEN_SOPHOS"}]
# APEIRON_A2A_ALLOWED_HOSTS=["sophos.example.org"]
# APEIRON_A2A_TOKEN_SOPHOS=
# Saltos de delegación A2A (A -> B = 1): corta bucles A -> B -> A.
APEIRON_A2A_MAX_HOPS=1

# Observabilidad y LangSmith Tracing
APEIRON_LANGSMITH_ENABLED=false
APEIRON_LANGSMITH_API_KEY=
APEIRON_LANGSMITH_PROJECT=apeiron-ecosystem
