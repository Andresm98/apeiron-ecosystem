[importlinter]
include_external_packages = True
root_packages =
    apeiron_core
    apeiron_infra
    apeiron_api

[importlinter:contract:layers]
name = Capas: api -> infra -> core (nunca al revés)
type = layers
layers =
    apeiron_api
    apeiron_infra
    apeiron_core

[importlinter:contract:core-is-vendor-free]
name = El núcleo no importa web, HTTP, JWT, vector stores ni SDKs
type = forbidden
source_modules = apeiron_core
forbidden_modules =
    fastapi
    httpx
    jwt
    bcrypt
    chromadb
    langchain
    mcp
    tenacity

[importlinter:contract:domain-is-inner-layer]
name = Dominio puro: no depende de aplicación ni de adaptadores
type = forbidden
source_modules = apeiron_core.domain
forbidden_modules =
    langgraph
    apeiron_core.application
    apeiron_infra
    apeiron_api

[importlinter:contract:application-does-not-import-adapters]
name = Aplicación independiente de infraestructura y presentación
type = forbidden
source_modules = apeiron_core.application
forbidden_modules =
    apeiron_infra
    apeiron_api
