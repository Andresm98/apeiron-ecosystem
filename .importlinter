[importlinter]
include_external_packages = True
root_packages =
    apeiron_core
    apeiron_agents
    apeiron_infra
    apeiron_api
    apeiron_mcp_scholar

[importlinter:contract:layers]
name = Capas: api -> infra | agents -> core (nunca al revés)
type = layers
layers =
    apeiron_api
    apeiron_infra | apeiron_agents
    apeiron_core

[importlinter:contract:core-is-vendor-free]
name = El núcleo no importa web, HTTP, JWT, vector stores ni SDKs
type = forbidden
source_modules = apeiron_core
forbidden_modules =
    fastapi
    httpx
    jwt
    bcrypt
    chromadb
    langchain
    mcp
    tenacity

[importlinter:contract:domain-is-inner-layer]
name = Dominio puro: no depende de aplicación ni de adaptadores
type = forbidden
source_modules = apeiron_core.domain
forbidden_modules =
    langgraph
    apeiron_core.application
    apeiron_infra
    apeiron_api

[importlinter:contract:application-does-not-import-adapters]
name = Aplicación independiente de infraestructura y presentación
type = forbidden
source_modules = apeiron_core.application
forbidden_modules =
    apeiron_infra
    apeiron_api

[importlinter:contract:mcp-scholar-is-standalone]
name = El servidor MCP apeiron-scholar es independiente (se comunica solo por MCP)
type = forbidden
source_modules = apeiron_mcp_scholar
forbidden_modules =
    apeiron_core
    apeiron_infra
    apeiron_api

[importlinter:contract:agents-are-data]
name = El catálogo de agentes solo declara datos: no conoce adaptadores ni LangGraph (ADR-013, catálogo de agentes)
type = forbidden
source_modules = apeiron_agents
forbidden_modules =
    apeiron_infra
    apeiron_api
    langgraph
